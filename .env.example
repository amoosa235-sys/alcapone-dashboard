# Supabase. The publishable key is safe to expose to the browser; RLS is what
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Bypasses RLS, so it must never reach the client bundle.
# Supabase dashboard -> Project Settings -> API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Claude, used for ticket classification, extraction and reply drafting.
ANTHROPIC_API_KEY=

# From a Shopify Partner app (Apps -> your app -> Client credentials).
# Without these the app runs fine; /channels just says Shopify is not set up.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Optional. Only needed if the forwarded host is not the origin Shopify should
# redirect back to.
SHOPIFY_APP_URL=
